[Unit]
Description=Serveur USB/IP (usb-over-ip)
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/sbin/modprobe usbip_host
ExecStart=/usr/sbin/usbipd
# Devices already plugged in at startup; later ones go through the udev rule
ExecStartPost=/usr/lib/usb-over-ip/uoip.py autobind
Restart=always

[Install]
WantedBy=multi-user.target
